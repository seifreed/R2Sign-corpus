#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)
cd "$root"

command -v jq >/dev/null
command -v shasum >/dev/null
command -v python3.14 >/dev/null

jq -e '
    .schema == "r2sign-corpus/v1"
    and .redistributable == true
    and (.license | type == "string" and length > 0)
    and (.provenance | type == "array" and length > 0)
    and (([.samples[].role] | unique | sort) ==
        ["goodware", "holdout", "mutation", "near_family", "training"])
    and all(.samples[];
        (.sample_id | type == "string" and length > 0)
        and (.family | type == "string" and length > 0)
        and (.path | type == "string" and test("^[^/[:space:]][^[:space:]]*$"))
        and ((.path | split("/")) | index("..") == null)
        and (.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
        and (.source_url | type == "string" and startswith("https://"))
        and (.similarity_algorithm | type == "string" and length > 0)
        and (.similarity_hash | type == "string" and length > 0)
        and (.first_seen | type == "string" and
            test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"))
        and (.builder | type == "string" and length > 0)
        and (((.campaign // "") | length > 0) or
            ((.sample_version // "") | length > 0))
        and (.runtime | type == "string" and length > 0)
        and (.label_confidence == "low" or .label_confidence == "medium" or
            .label_confidence == "high"))
    and (([.samples[].sample_id] | length) == ([.samples[].sample_id] | unique | length))
    and (([.samples[].path] | length) == ([.samples[].path] | unique | length))
    and (([.samples[].sha256] | length) == ([.samples[].sha256] | unique | length))
    and (([.samples[] | [(.similarity_algorithm | ascii_downcase), .similarity_hash]] | length) ==
        ([.samples[] | [(.similarity_algorithm | ascii_downcase), .similarity_hash]] | unique | length))
' manifest.json >/dev/null

jq -e -s '
    .[0] as $manifest |
    .[1] as $evidence |
    ($evidence.samples | map({key:.sha256, value:.label_confidence}) | from_entries) as $labels |
    $evidence.schema == "r2sign-label-evidence/v1"
    and $evidence.source_commit == "5200762e5db1d33b77a125a6964fed49b3c2dd2d"
    and (($evidence.samples | length) == ($manifest.samples | length))
    and (($evidence.samples | map(.sha256) | length) ==
        ($evidence.samples | map(.sha256) | unique | length))
    and all($manifest.samples[]; .label_confidence == $labels[.sha256])
    and all($evidence.samples[];
        (.confidence_score >= 0 and .confidence_score <= 1)
        and .label_confidence ==
            (if .confidence_score >= 0.8 then "high"
             elif .confidence_score >= 0.5 then "medium"
             else "low" end))
' manifest.json metadata/label-evidence.json >/dev/null

jq -e -s '
    .[0] as $manifest |
    .[1] as $evidence |
    ($evidence.samples | map({key:.sha256, value:.runtime}) | from_entries) as $runtimes |
    $evidence.schema == "r2sign-runtime-evidence/v1"
    and $evidence.extractor.command == "rabin2 -Ij"
    and (($evidence.samples | length) == ($manifest.samples | length))
    and (($evidence.samples | map(.sha256) | length) ==
        ($evidence.samples | map(.sha256) | unique | length))
    and all($manifest.samples[]; .runtime == $runtimes[.sha256])
    and all($evidence.samples[];
        .runtime == ((.os | ascii_downcase) + "-" + (.arch | ascii_downcase) + "-" + (.bits | tostring)))
' manifest.json metadata/runtime-evidence.json >/dev/null

jq -e -s '
    .[0] as $manifest |
    .[1] as $evidence |
    ($evidence.samples | map({key:.sha256, value:.}) | from_entries) as $records |
    $evidence.schema == "r2sign-provenance-evidence/v1"
    and $evidence.source_snapshot == "5200762e5db1d33b77a125a6964fed49b3c2dd2d"
    and $evidence.builder_extractor.command == "rabin2 -HHj"
    and (($evidence.samples | length) == ($manifest.samples | length))
    and (($evidence.samples | map(.sha256) | length) ==
        ($evidence.samples | map(.sha256) | unique | length))
    and all($manifest.samples[];
        .first_seen == $records[.sha256].first_seen
        and .sample_version == $records[.sha256].sample_version
        and .builder == $records[.sha256].builder)
    and all($evidence.samples[];
        (.source_commit | test("^[0-9a-f]{40}$"))
        and (.builder_evidence.fingerprint_sha256 | test("^[0-9a-f]{64}$"))
        and .builder == (.builder_evidence.kind + ":" +
            .builder_evidence.fingerprint_sha256[0:16])
        and (.builder_evidence.kind == "rich" or
            .builder_evidence.kind == "pe-header" or
            .builder_evidence.kind == "binary-prefix"))
' manifest.json metadata/provenance-evidence.json >/dev/null

python3.14 - <<'PY'
from collections import defaultdict
from datetime import datetime
import json
from pathlib import Path

samples = json.loads(Path("manifest.json").read_text(encoding="utf-8"))["samples"]
families = defaultdict(lambda: {"training": [], "holdout": []})
for sample in samples:
    if sample["role"] in {"training", "holdout"}:
        families[sample["family"]][sample["role"]].append(sample)
for family, split in families.items():
    training = split["training"]
    holdout = split["holdout"]
    if not training or not holdout:
        raise ValueError(f"temporal split is incomplete for {family}")
    if min(datetime.fromisoformat(item["first_seen"]) for item in holdout) <= max(
        datetime.fromisoformat(item["first_seen"]) for item in training
    ):
        raise ValueError(f"holdout is not newer than training for {family}")
    training_versions = {item["sample_version"] for item in training}
    holdout_versions = {item["sample_version"] for item in holdout}
    if training_versions & holdout_versions:
        raise ValueError(f"sample version crosses the temporal split for {family}")
PY

checksums=$(mktemp)
trap 'rm -f "$checksums"' EXIT HUP INT TERM
jq -r '.samples[] | "\(.sha256)  \(.path)"' manifest.json >"$checksums"
shasum -a 256 -c "$checksums" >/dev/null

manifest_sha256=$(shasum -a 256 manifest.json | cut -d ' ' -f 1)
for audit in metadata/vt-materialization.json metadata/rl-materialization.json; do
    jq -e --arg manifest_sha256 "$manifest_sha256" '
        .manifest_sha256 == $manifest_sha256
        and .samples_requested == ((.sha256 | length) + (.missing_sha256 | length))
        and ((.sha256 | length) == (.sha256 | unique | length))
        and ((.missing_sha256 | length) == (.missing_sha256 | unique | length))
    ' "$audit" >/dev/null
    jq -e -s '
        ([.[0].samples[] | select(.role != "mutation") | .sha256] | sort) ==
        ((.[1].sha256 + .[1].missing_sha256) | sort)
    ' manifest.json "$audit" >/dev/null
done
jq -e '.schema == "r2sign-vt-materialization/v1"' metadata/vt-materialization.json >/dev/null
jq -e '.schema == "r2sign-rl-materialization/v1"' metadata/rl-materialization.json >/dev/null

jq -e '
    .schema == "r2sign-a1000-corpus/v1"
    and .provider == "ReversingLabs A1000"
    and .redistributable == false
    and (.samples | type == "array" and length > 0)
    and (([.samples[].sha256] | length) == ([.samples[].sha256] | unique | length))
    and all(.samples[];
        (.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
        and (.family | type == "string" and length > 0)
        and .classification == "Malicious"
        and (.sample_type | type == "string" and startswith("PE"))
        and (.size | type == "number" and . > 0)
        and (.first_seen | type == "string" and length > 0))
' metadata/a1000-corpus.json >/dev/null
a1000_manifest_sha256=$(shasum -a 256 metadata/a1000-corpus.json | cut -d ' ' -f 1)
jq -e --arg manifest_sha256 "$a1000_manifest_sha256" '
    .schema == "r2sign-rl-materialization/v1"
    and .manifest_sha256 == $manifest_sha256
    and .samples_requested == (.sha256 | length)
    and .samples_verified == (.sha256 | length)
    and .samples_missing == 0
    and (.missing_sha256 | length) == 0
' metadata/a1000-materialization.json >/dev/null
jq -e -s '
    ([.[0].samples[].sha256] | sort) == (.[1].sha256 | sort)
' metadata/a1000-corpus.json metadata/a1000-materialization.json >/dev/null

expected_goodware=$(jq -r '.sha256' goodware-db/manifest.json)
actual_goodware=$(shasum -a 256 goodware-db/goodware_patterns.db | cut -d ' ' -f 1)
test "$actual_goodware" = "$expected_goodware"
python3.14 tools/build_scale_fixtures.py --verify

printf 'corpus: ok (%s samples)\n' "$(jq '.samples | length' manifest.json)"
