#!/bin/sh
set -eu

if [ "$#" -lt 3 ] || [ "$#" -gt 4 ]; then
    echo "usage: vt-materialize MANIFEST OUTPUT AUDIT [LIMIT]" >&2
    exit 2
fi

manifest=$1
output=$2
audit=$3
limit=${4:-}

if [ -n "$limit" ] && { ! [ "$limit" -eq "$limit" ] 2>/dev/null || [ "$limit" -lt 1 ]; }; then
    echo "LIMIT must be a positive integer" >&2
    exit 2
fi

command -v vt >/dev/null
command -v jq >/dev/null
command -v shasum >/dev/null

jq -e '
    .schema == "r2sign-corpus/v1"
    and .redistributable == true
    and (.license | type == "string" and length > 0)
    and (.provenance | type == "array" and length > 0)
    and (.samples | type == "array" and length > 0)
' "$manifest" >/dev/null

jq -e '
    [.samples[] | select(.role != "mutation") |
        (.source_url | type == "string" and startswith("https://"))] | all
' "$manifest" >/dev/null

hashes=$(mktemp)
hash_array=$(mktemp)
pending=$(mktemp)
verified=$(mktemp)
absent=$(mktemp)
absent_array=$(mktemp)
trap 'rm -f "$hashes" "$hash_array" "$pending" "$verified" "$absent" "$absent_array"' EXIT HUP INT TERM

jq -er '
    .samples[] | select(.role != "mutation") | .sha256 |
    select(test("^[0-9a-fA-F]{64}$")) | ascii_downcase
' "$manifest" >"$hashes"

if [ -n "$limit" ]; then
    head -n "$limit" "$hashes" >"$hashes.limited"
    mv "$hashes.limited" "$hashes"
fi

if [ "$(sort "$hashes" | uniq | wc -l | tr -d ' ')" -ne "$(wc -l <"$hashes" | tr -d ' ')" ]; then
    echo "corpus SHA-256 values must be unique" >&2
    exit 1
fi

mkdir -p "$output" "$(dirname "$audit")"
while IFS= read -r digest; do
    if [ -f "$output/$digest" ] &&
        [ "$(shasum -a 256 "$output/$digest" | cut -d ' ' -f 1)" = "$digest" ]; then
        continue
    fi
    printf '%s\n' "$digest" >>"$pending"
done <"$hashes"

vt_status=0
if [ -s "$pending" ]; then
    vt --silent download - --output "$output" --threads 5 <"$pending" || vt_status=$?
fi

while IFS= read -r digest; do
    if [ -f "$output/$digest" ] &&
        [ "$(shasum -a 256 "$output/$digest" | cut -d ' ' -f 1)" = "$digest" ]; then
        printf '%s\n' "$digest" >>"$verified"
    else
        printf '%s\n' "$digest" >>"$absent"
    fi
done <"$hashes"

jq -Rs 'split("\n") | map(select(length > 0)) | sort' "$verified" >"$hash_array"
jq -Rs 'split("\n") | map(select(length > 0)) | sort' "$absent" >"$absent_array"
manifest_sha256=$(shasum -a 256 "$manifest" | cut -d ' ' -f 1)
jq -n \
    --arg manifest_sha256 "$manifest_sha256" \
    --argjson vt_exit_code "$vt_status" \
    --slurpfile hashes "$hash_array" \
    --slurpfile missing "$absent_array" \
    '{
        schema: "r2sign-vt-materialization/v1",
        manifest_sha256: $manifest_sha256,
        vt_exit_code: $vt_exit_code,
        samples_requested: (($hashes[0] | length) + ($missing[0] | length)),
        samples_verified: ($hashes[0] | length),
        samples_missing: ($missing[0] | length),
        sha256: $hashes[0],
        missing_sha256: $missing[0]
    }' >"$audit.tmp"
mv "$audit.tmp" "$audit"

verified_count=$(wc -l <"$verified" | tr -d ' ')
absent_count=$(wc -l <"$absent" | tr -d ' ')
printf 'verified=%s missing=%s\n' "$verified_count" "$absent_count"
test "$vt_status" -eq 0 && test "$absent_count" -eq 0
